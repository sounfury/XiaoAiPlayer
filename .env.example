MI_USER=
MI_PASS=
MI_DID=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_DEVICE_NAME=

JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.5

POLL_INTERVAL=2
APP_SCAN_INTERVAL=300
LOG_LEVEL=INFO

# Optional authenticated task completion webhook. Set a token before enabling.
HOOK_ENABLED=false
HOOK_HOST=127.0.0.1
HOOK_PORT=8765
HOOK_TOKEN=
# Plain placeholders supported: {source}, {event_id}, {task}.
HOOK_TEXT="{source}提醒你，{task}已经完成啦"
# Optional reverse tunnel; use a Host alias from ~/.ssh/config.
HOOK_SSH_HOST=
HOOK_SSH_REMOTE_PORT=8765
